# GitHub App ID from the app's settings page.
APP_ID=

# Private key contents, or path to the downloaded .pem file.
# Use PRIVATE_KEY for the PEM body, or PRIVATE_KEY_PATH for a local file.
PRIVATE_KEY=
# PRIVATE_KEY_PATH=

# Webhook secret configured on the GitHub App. Required by Probot.
WEBHOOK_SECRET=

# Development only. smee.io (or similar) URL for local webhook delivery.
# Do not set this in Render/production.
WEBHOOK_PROXY_URL=

# Render and other PaaS hosts must bind on 0.0.0.0. Local default is localhost.
# HOST=0.0.0.0

# Optional. Local server bind settings. Render provides PORT automatically.
# PORT=3000
# WEBHOOK_PATH=/api/github/webhooks

# Optional. fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
